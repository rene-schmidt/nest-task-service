// This is your Prisma schema file.
// It defines the data model (tables/enums) and how Prisma generates the client.

// Generator configuration for Prisma Client (TypeScript/JavaScript ORM client).
generator client {
  provider = "prisma-client-js"
}

// Database connection configuration.
datasource db {
  provider = "postgresql" // Database provider (PostgreSQL)
  url      = env("DATABASE_URL") // Connection string provided via environment variable
}

// Job model representing a single background job tracked in the database.
model Job {
  id        String    @id @default(uuid()) // Primary key as UUID
  status    JobStatus // Current job state
  createdAt DateTime  @default(now()) // Creation timestamp
  updatedAt DateTime  @updatedAt // Updated automatically on each change
}

// Enum defining allowed job states.
enum JobStatus {
  PENDING // Job created but not started
  PROCESSING // Job currently running
  DONE // Job completed successfully
  FAILED // Job failed
}
